{
  "name": "nova-sdk-js",
  "version": "1.1.1",
  "description": "JavaScript SDK for multi-user NOVA: Secure file sharing on NEAR with Shade/TEEs key management.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "near",
    "blockchain",
    "ipfs",
    "encryption",
    "tee",
    "shade-agent"
  ],
  "author": "jcarbonnell",
  "license": "MIT",
  "dependencies": {
    "@near-js/providers": "^2.3.3",
    "axios": "^1.7.7"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.4",
    "babel-jest": "^30.2.0",
    "dotenv": "^17.2.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}

{
  "info": {
    "title": "NOVA Shade Agent (internal)",
    "version": "0.4.0",
    "description": "Internal key-management API. Every endpoint requires the X-Internal-Auth shared secret and is reachable only by the MCP server and the nova-landing server-side routes. NOT a public API."
  },
  "openapi": "3.1.1",
  "paths": {
    "/user-keys/store": {
      "post": {
        "operationId": "userKeys.store",
        "summary": "Store a user keypair (encrypted) in KV",
        "tags": [
          "internal"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "minLength": 1
                  },
                  "account_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "private_key": {
                    "type": "string",
                    "pattern": "^ed25519:.*"
                  },
                  "public_key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "network": {
                    "enum": [
                      "testnet",
                      "mainnet"
                    ],
                    "type": "string"
                  },
                  "auth_token": {
                    "type": "string"
                  },
                  "wallet_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "account_id",
                  "private_key",
                  "public_key",
                  "network"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "account_id": {
                      "type": "string"
                    },
                    "network": {
                      "type": "string"
                    },
                    "wallet_id": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "checksum": {
                      "type": "string"
                    },
                    "key_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "account_id",
                    "network",
                    "wallet_id",
                    "checksum",
                    "key_id"
                  ]
                }
              }
            }
          }
        }
      }
    },

{
  "name": "@nova-sdk/contract",
  "version": "0.4.0",
  "description": "Contract-first description of NOVA's public wire protocol (MCP /tools/*).",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/jcarbonnell/nova" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./contract": { "types": "./dist/contract.d.ts", "import": "./dist/contract.js" },
    "./openapi.json": "./openapi.json"
  },
  "files": ["dist", "openapi.json", "README.md"],
  "scripts": {
    "build": "tsc",
    "openapi": "tsx scripts/generate-openapi.ts",
    "harness": "node test/harness.mjs"
  },
  "dependencies": {
    "@orpc/contract": "1.14.8",
    "@orpc/client": "1.14.8",
    "@orpc/openapi": "1.14.8",
    "@orpc/openapi-client": "1.14.8",
    "@orpc/zod": "1.14.8",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
+            .with_session_token(&session_token())
+            .with_wallet_signer(Arc::new(EmptyHashSigner { events: mock.events.clone() }));
+        let sdk = NovaSdk::with_config(ACCOUNT, config).unwrap();
+        let err = sdk.upload("test-group", b"Hello NOVA!", "hello.txt").await.unwrap_err();
+        assert!(matches!(err, NovaError::Wallet(_)), "got {err:?}");
+        assert!(err.to_string().contains("no transaction hash"), "got {err}");
+        assert!(!mock.events().contains(&"mcp:finalize_upload".to_string()));

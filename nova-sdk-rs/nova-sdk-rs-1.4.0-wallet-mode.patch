+        let mock = Mock {
+            url: format!("http://{}", listener.local_addr().unwrap()),
+            events: Arc::new(Mutex::new(Vec::new())),
+            bodies: Arc::new(Mutex::new(HashMap::new())),
+            responses: Arc::new(Mutex::new(default_responses())),
+            authorized: Arc::new(AtomicBool::new(false)),
+        };
+        let m = mock.clone();
+        tokio::spawn(async move {
+            loop {
+                let (mut sock, _) = listener.accept().await.unwrap();
+                let m = m.clone();
+                tokio::spawn(async move {
+                    let (path, body) = read_request(&mut sock).await;
+                    let req: serde_json::Value = serde_json::from_slice(&body).unwrap_or(json!({}));
+                    let (status, resp) = if let Some(tool) = path.strip_prefix("/tools/") {
+                        m.events.lock().unwrap().push(format!("mcp:{tool}"));
+                        m.bodies.lock().unwrap().insert(tool.to_string(), req);
+                        match m.responses.lock().unwrap().get(tool).cloned() {
+                            Some(r) => (200, r),
+                            None => (500, json!({ "error": format!("unexpected tool {tool}") })),
+                        }
+                    } else {
+                        let params = &req["params"];
+                        let method = params["method_name"].as_str().unwrap_or("?").to_string();
+                        m.events.lock().unwrap().push(format!("view:{method}"));
+                        let args: serde_json::Value = base64::engine::general_purpose::STANDARD
+                            .decode(params["args_base64"].as_str().unwrap_or(""))
+                            .ok()
+                            .and_then(|b| serde_json::from_slice(&b).ok())
+                            .unwrap_or(json!({}));
+                        let out = match method.as_str() {
+                            "estimate_fee" => fee(args["action"].as_str().unwrap_or("")).to_string(),
+                            "is_authorized" => m.authorized.load(Ordering::SeqCst).to_string(),
+                            _ => "null".to_string(),
+                        };
+                        (200, rpc_result(&req["id"], out.into_bytes()))
+                    };
+                    let text = resp.to_string();
+                    let reply = format!(
+                        "HTTP/1.1 {} OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}",
+                        status, text.len(), text
+                    );
+                    let _ = sock.write_all(reply.as_bytes()).await;
+                    let _ = sock.shutdown().await;
+                });
+            }
+        });
+        mock
+    }
+
+    struct MockSigner {
+        account: String,
+        events: Arc<Mutex<Vec<String>>>,
+        calls: Arc<Mutex<Vec<WalletFunctionCall>>>,
+        reject: bool,
+    }
+
+    impl NovaWalletSigner for MockSigner {
+        fn account_id(&self) -> &str { &self.account }
+        fn sign_and_send_function_call<'a>(
+            &'a self,
+            call: WalletFunctionCall,
+        ) -> Pin<Box<dyn Future<Output = Result<String, String>> + Send + 'a>> {
+            Box::pin(async move {
+                self.events.lock().unwrap().push(format!("wallet:{}", call.method_name));
+                let method = call.method_name.clone();
+                self.calls.lock().unwrap().push(call);
+                if self.reject { Err("User rejected the request".to_string()) } else { Ok(format!("TX_{method}")) }
+            })
+        }
+    }
+
+    fn session_token() -> String {
+        let b64u = |s: String| base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(s.as_bytes());
+        let exp = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs() + 3600;
+        format!("{}.{}.sig",
+            b64u(r#"{"alg":"HS256","typ":"JWT"}"#.to_string()),
+            b64u(format!(r#"{{"account_id":"{ACCOUNT}","exp":{exp}}}"#)))
+    }
+
+    struct Harness {
+        sdk: NovaSdk,
+        mock: Mock,
+        calls: Arc<Mutex<Vec<WalletFunctionCall>>>,
+    }
+
+    impl Harness {
+        fn calls(&self) -> Vec<WalletFunctionCall> { self.calls.lock().unwrap().clone() }
+    }
+
+    async fn harness(wallet: bool, reject: bool) -> Harness {
+        let mock = start_mock().await;
+        let calls = Arc::new(Mutex::new(Vec::new()));
+        let mut config = NovaSdkConfig {
+            rpc_url: mock.url.clone(),
+            mcp_url: mock.url.clone(),
+            ..NovaSdkConfig::default()
+        }
+        .with_session_token(&session_token());
+        if wallet {
+            config = config.with_wallet_signer(Arc::new(MockSigner {
+                account: ACCOUNT.to_string(),
+                events: mock.events.clone(),
+                calls: calls.clone(),
+                reject,
+            }));
+        }
+        let sdk = NovaSdk::with_config(ACCOUNT, config).unwrap();
+        Harness { sdk, mock, calls }
+    }
+
+    fn ev(list: &[&str]) -> Vec<String> { list.iter().map(|s| s.to_string()).collect() }

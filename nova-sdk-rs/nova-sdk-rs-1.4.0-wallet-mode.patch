+/// A contract call the SDK asks the user's wallet to sign and send (self-custodial mode).
+#[derive(Debug, Clone, PartialEq)]
+pub struct WalletFunctionCall {
+    pub receiver_id: String,
+    pub method_name: String,
+    pub args: serde_json::Value,
+    pub gas: u64,      // gas units
+    pub deposit: u128, // yoctoNEAR
+}
+
+/// Self-custodial signer: the user's own wallet signs and pays for every contract
+/// write. NOVA never holds this key. The app implements it (a local key, a wallet
+/// bridge, an HSM); the SDK only needs this shape. Mirror of nova-sdk-js
+/// `NovaWalletSigner`.
+pub trait NovaWalletSigner: Send + Sync {
+    /// The wallet's account. Must equal the SDK account.
+    fn account_id(&self) -> &str;
+    /// Sign, send, and wait for the call; resolve with the transaction hash.
+    /// Return Err if the user declines or the transaction fails.
+    fn sign_and_send_function_call<'a>(
+        &'a self,
+        call: WalletFunctionCall,
+    ) -> Pin<Box<dyn Future<Output = Result<String, String>> + Send + 'a>>;
+}
+
+impl std::fmt::Debug for dyn NovaWalletSigner {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "NovaWalletSigner({})", self.account_id())
+    }
+}

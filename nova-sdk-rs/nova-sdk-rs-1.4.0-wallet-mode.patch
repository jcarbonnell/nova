+    // Wallet-signed contract write. Fee is read live from the contract (never
+    // hard-coded); fee_action None ⇒ zero-fee method. Returns the tx hash.
+    async fn wallet_call(
+        &self,
+        method_name: &str,
+        args: serde_json::Value,
+        fee_action: Option<&str>,
+    ) -> Result<String, NovaError> {
+        let signer = self
+            .wallet_signer
+            .as_ref()
+            .ok_or_else(|| NovaError::Wallet("wallet_call without wallet_signer".to_string()))?;
+        let deposit = match fee_action {
+            Some(action) => self.estimate_fee(action).await?,
+            None => 0,
+        };
+        let call = WalletFunctionCall {
+            receiver_id: self.contract_id.to_string(),
+            method_name: method_name.to_string(),
+            args,
+            gas: WALLET_CALL_GAS,
+            deposit,
+        };
+        let rejected = |why: String| NovaError::Wallet(format!(
+            "Wallet transaction '{}' failed or was rejected: {}", method_name, why
+        ));
+        match signer.sign_and_send_function_call(call).await {
+            Ok(tx_hash) if !tx_hash.is_empty() => Ok(tx_hash),
+            Ok(_) => Err(rejected("wallet returned no transaction hash".to_string())),
+            Err(e) => Err(rejected(e)),
+        }
+    }

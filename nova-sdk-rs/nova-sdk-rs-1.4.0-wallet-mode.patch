+    /// A wallet that "succeeds" without a transaction hash must not let finalize run
+    /// (finalize verifies the record by that hash; an empty one would skip the gate).
+    struct EmptyHashSigner { events: Arc<Mutex<Vec<String>>> }
+    impl NovaWalletSigner for EmptyHashSigner {
+        fn account_id(&self) -> &str { ACCOUNT }
+        fn sign_and_send_function_call<'a>(
+            &'a self,
+            call: WalletFunctionCall,
+        ) -> Pin<Box<dyn Future<Output = Result<String, String>> + Send + 'a>> {
+            Box::pin(async move {
+                self.events.lock().unwrap().push(format!("wallet:{}", call.method_name));
+                Ok(String::new())
+            })
+        }
+    }

{
  "name": "nova-sdk-js",
  "version": "0.1.2",
  "description": "JavaScript SDK for NOVA: Secure file sharing on NEAR. Wraps contract calls, encryption, IPFS.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "near",
    "blockchain",
    "ipfs",
    "encryption"
  ],
  "author": "jcarbonnell",
  "license": "MIT",
  "dependencies": {
    "@near-js/accounts": "^2.3.3",
    "@near-js/crypto": "^2.3.3",
    "@near-js/keystores": "^2.3.3",
    "@near-js/providers": "^2.3.3",
    "@near-js/signers": "^2.3.3",
    "axios": "^1.7.7",
    "form-data": "^4.0.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.4",
    "dotenv": "^17.2.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
